addMarkers(
lng = ~df$longitude, lat = ~df$latitude,
popup = paste(
df$name, "<br>",
df$address, "<br>",
df$stars, "stars", "<br>",
df$review_count, "reviews", "<br>",
input$base_category, "<br>"
)
) %>%
addTiles()
})
