# Reactivo: reviews por ciudad para analisis de texto
reviews_by_city <- reactive({
req(input$city_name4)
restaurants_reviews_full_clean %>%
filter(city_upper == input$city_name4)
})
# Reactivo: genera bigramas desde reviews
bigram_generate <- reactive({
reviews_by_city <- reviews_by_city()
# Si no hay textos, devuelve tibble vacio
if (nrow(reviews_by_city) == 0) {
return(tibble(bigram = character(), n = integer()))
}
# Tokeniza a bigramas y filtra ruido
bigrams <- reviews_by_city %>%
unnest_tokens(bigram, text, token = "ngrams", n = 2) %>%
separate(bigram, c("word1", "word2"), sep = " ") %>%
filter(
!word1 %in% stop_words$word,
!word2 %in% stop_words$word,
!str_detect(word2, pattern = "[[:digit:]]"),
!str_detect(word1, pattern = "[[:punct:]]"),
!str_detect(word2, pattern = "[[:punct:]]"),
!str_detect(word1, pattern = "\\b(.)\\b"),
!str_detect(word2, pattern = "\\b(.)\\b")
) %>%
unite("bigram", c(word1, word2), sep = " ") %>%
count(bigram) %>%
top_n(30)
})
# Render del wordcloud de bigramas
output$bigram_wordcloud <- renderPlot({
bg <- bigram_generate()
validate(need(nrow(bg) > 0, "No hay suficiente texto en esta ciudad para bigramas."))
wordcloud(
bg$bigram, bg$n,
scale = c(3, 0.6),
colors = brewer.pal(12, "Paired")
)
})
}
# Ejecuta la aplicacion Shiny
shinyApp(ui = ui, server = server)
reviews <- readRDS("Restaurants_review.rds")
names(reviews)
sum(!is.na(reviews$text) & nchar(reviews$text) > 0)
rests <- read.csv("Restaurants_new.csv", stringsAsFactors = FALSE)
reviews_clean <- reviews %>%
inner_join(rests %>% dplyr::select(business_id, city), by = "business_id") %>%
mutate(city_upper = toupper(city))
reviews_clean %>%
summarise(
total_reviews = n(),
total_text = sum(!is.na(text) & nchar(text) > 0)
)
reviews_clean %>%
filter(city_upper == "GLENDALE") %>%
summarise(
n_reviews = n(),
n_text = sum(!is.na(text) & nchar(text) > 0)
)
reviews_clean %>%
filter(!is.na(text) & nchar(text) > 0) %>%
count(city_upper, sort = TRUE)
glend <- reviews_clean %>% filter(city_upper == "GLENDALE")
bg_raw <- glend %>%
tidytext::unnest_tokens(bigram, text, token = "ngrams", n = 2)
nrow(bg_raw)
head(bg_raw)
lasv <- reviews_clean %>%
filter(city_upper == "LAS VEGAS")
bg_raw <- lasv %>%
tidytext::unnest_tokens(bigram, text, token = "ngrams", n = 2)
nrow(bg_raw)
head(bg_raw)
library(tidyr)
library(stringr)
library(tidytext)
bg_filt <- bg_raw %>%
separate(bigram, c("word1", "word2"), sep = " ") %>%
filter(
!word1 %in% stop_words$word,
!word2 %in% stop_words$word,
!str_detect(word1, "[[:digit:]]"),
!str_detect(word2, "[[:digit:]]"),
!str_detect(word1, "[[:punct:]]"),
!str_detect(word2, "[[:punct:]]"),
!str_detect(word1, "\\b(.)\\b"),
!str_detect(word2, "\\b(.)\\b")
) %>%
unite("bigram", c(word1, word2), sep = " ")
nrow(bg_filt)
bg_counts <- bg_filt %>%
count(bigram, sort = TRUE)
head(bg_counts, 20)
shiny::runApp()
# =========================
# 0) Libraries
# =========================
# Paquete base para manipulacion y visualizacion
library(tidyverse)
# Lectura de JSON (si se requiere en extensiones futuras)
library(jsonlite)
# Mapas y geocodificacion
library(ggmap)
# Mapas interactivos
library(leaflet)
# Nubes de palabras
library(wordcloud)
# Utilidades de texto y patrones
library(stringr)
# NLP en tidyverse (tokenizacion, stopwords)
library(tidytext)
# dplyr explicito para manipulacion de datos
library(dplyr)
# Dataset principal de negocios Yelp
yelp <- readRDS("yelp.rds")
# Crea columna en mayusculas para filtrar consistentemente
yelp <- yelp %>%
mutate(city_upper = toupper(city)) %>%
# Agrupa por ciudad para filtrar ciudades con pocos registros
group_by(city_upper) %>%
# Deja solo ciudades con suficiente volumen, direccion valida y excluye Calgary
filter(n() > 2000 & address != "" & city_upper != "CALGARY") %>%
# Quita agrupamiento para operaciones posteriores
ungroup()
# Crea una categoria base para facilitar filtros en la app
yelp <- yelp %>%
mutate(base_category = case_when(
grepl("Restaurants", categories) ~ "Restaurants",
grepl("Food", categories) | grepl("Grocery", categories) ~ "Grocery/Convenience Store",
grepl("Nighlife", categories) | grepl("Bars", categories) | grepl("Dance", categories) ~ "Nightlife",
grepl("Active Life", categories) ~ "Active Life",
grepl("Salons", categories) | grepl("Beauty", categories) ~ "Beauty Services",
grepl("Entertainment", categories) | grepl("Museums", categories) ~ "Entertainment",
grepl("Shopping", categories) ~ "Shopping",
grepl("Services", categories) ~ "Services",
grepl("Auto", categories) | grepl("Automotive", categories) ~ "Auto Repairs",
grepl("Medical", categories) | grepl("Doctors", categories) | grepl("Dentists", categories) ~ "Medical"
)) %>%
# Elimina filas sin categoria base
drop_na(base_category)
# Subconjunto que contiene solo restaurantes
yelp.restaurants <- yelp %>%
filter(base_category == "Restaurants")
# Lista de ciudades unicas (en mayusculas) para los selectInput
unique_cities <- unique(yelp$city_upper)
# Ordena las ciudades para presentacion en la UI
unique_cities <- str_sort(unique_cities, decreasing = TRUE, numeric = FALSE)
# Lista de categorias base unicas para el filtro principal
unique_categories <- unique(yelp$base_category)
# Ordena las categorias para presentacion en la UI
unique_categories <- str_sort(unique_categories, decreasing = TRUE, numeric = FALSE)
# Dataset reducido para graficos y tabla
yelp.plot <- yelp %>%
select(
name, address, city_upper, state, postal_code, latitude, longitude,
stars, review_count, is_open, categories, base_category
)
# Tabla con nombres amigables para DataTable
table_display <- yelp.plot %>%
rename(
City = city_upper,
Business_Name = name,
Address = address,
Latitude = latitude,
Longitude = longitude,
Star_Ratings = stars,
Review_Count = review_count,
Open_Status = is_open,
Sub_Categories = categories,
Base_Category = base_category
)
# Carga dataset de restaurantes con categorias
restaurants_full <- read.csv("Restaurants_new.csv", stringsAsFactors = FALSE)
# Carga reviews de restaurantes
restaurants_reviews_full <- readRDS("Restaurants_review.rds")
# Clasifica la cocina principal segun palabras clave en categorias
restaurants_full <- restaurants_full %>%
mutate(
cuisine = case_when(
grepl("american", categories, ignore.case = TRUE) |
grepl("Sandwiches", categories, ignore.case = TRUE) |
grepl("Fast Food", categories, ignore.case = TRUE) |
grepl("Burgers", categories, ignore.case = TRUE) ~ "American",
grepl("italian", categories, ignore.case = TRUE) ~ "Italian",
grepl("mexican", categories, ignore.case = TRUE) ~ "Mexican",
grepl("chinese", categories, ignore.case = TRUE) ~ "Chinese",
grepl("indian", categories, ignore.case = TRUE) ~ "Indian",
grepl("thai", categories, ignore.case = TRUE) ~ "Thai",
grepl("korean", categories, ignore.case = TRUE) ~ "Korean",
grepl("japanese", categories, ignore.case = TRUE) ~ "Japanese",
grepl("french", categories, ignore.case = TRUE) ~ "French",
grepl("vietnamese", categories, ignore.case = TRUE) ~ "Vietnamese",
grepl("mediterranean", categories, ignore.case = TRUE) ~ "Mediterranean",
grepl("hawaiian", categories, ignore.case = TRUE) ~ "Hawaiian",
TRUE ~ "Others"
)
)
# Une reviews con info de ciudad/barrio/cocina y crea ciudad en mayusculas
restaurants_reviews_full_clean <- restaurants_reviews_full %>%
inner_join(
restaurants_full %>% select(business_id, city, neighborhood, cuisine),
by = "business_id",
suffix = c("", "_rf")
) %>%
# Si existen columnas duplicadas, se consolida con coalesce
mutate(
city = if ("city" %in% names(.) && "city_rf" %in% names(.)) {
coalesce(.data$city, .data$city_rf)
} else if ("city" %in% names(.)) {
.data$city
} else {
.data$city_rf
},
neighborhood = if ("neighborhood" %in% names(.) && "neighborhood_rf" %in% names(.)) {
coalesce(.data$neighborhood, .data$neighborhood_rf)
} else if ("neighborhood" %in% names(.)) {
.data$neighborhood
} else {
.data$neighborhood_rf
},
cuisine = if ("cuisine" %in% names(.) && "cuisine_rf" %in% names(.)) {
coalesce(.data$cuisine, .data$cuisine_rf)
} else if ("cuisine" %in% names(.)) {
.data$cuisine
} else {
.data$cuisine_rf
},
# Columna auxiliar en mayusculas para filtros
city_upper = toupper(city)
) %>%
# Elimina columnas duplicadas creadas por el join
select(-any_of(c("city_rf", "neighborhood_rf", "cuisine_rf")))
# Ciudades disponibles en el dataset de reviews (para el selector de Text Analysis)
unique_cities_reviews <- restaurants_reviews_full_clean %>%
distinct(city_upper) %>%
filter(!is.na(city_upper) & city_upper != "") %>%
arrange(city_upper) %>%
pull(city_upper)
# Construye dataframe de sentimientos para el grafico facetado
sentiment_source <- restaurants_reviews_full_clean
# Asegura que exista la columna cuisine para evitar fallos en count()
if (!"cuisine" %in% names(sentiment_source)) {
sentiment_source <- sentiment_source %>% mutate(cuisine = "Others")
}
# Si hay columna stars, se infiere sentimiento; si no, todo es neutral
if ("stars" %in% names(sentiment_source)) {
sentiment_source <- sentiment_source %>%
mutate(
sentiment = case_when(
stars >= 4 ~ "positive",
stars <= 2 ~ "negative",
TRUE ~ "neutral"
)
)
} else {
sentiment_source <- sentiment_source %>%
mutate(sentiment = "neutral")
}
# Selecciona top 5 cocinas por frecuencia
top_cuisines <- sentiment_source %>%
count(cuisine, sort = TRUE) %>%
slice_head(n = 5) %>%
pull(cuisine)
# Calcula proporcion de sentimientos por cocina top
topSentiments_review <- sentiment_source %>%
filter(cuisine %in% top_cuisines) %>%
count(cuisine, sentiment, name = "n") %>%
group_by(cuisine) %>%
mutate(proportion = n / sum(n)) %>%
ungroup()
runApp()
